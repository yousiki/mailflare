{
  "name": "mailflare",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --cwd apps/mailflare dev",
    "build": "turbo run build",
    "start": "bun run --cwd apps/mailflare preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt .",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:watch": "bun run --cwd apps/mailflare test --watch",
    "deploy": "bun run --cwd apps/mailflare build && bunx alchemy deploy infra/alchemy.run.ts --stage production",
    "deploy:local": "bun run deploy",
    "deploy:worker": "bun run deploy",
    "upload": "bun run --cwd apps/mailflare build",
    "preview": "bun run --cwd apps/mailflare preview"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/zod-adapter": "^1.167.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.0-rc.112",
    "hono": "^4.13.5",
    "lucide-react": "^1.16.0",
    "mimetext": "^3.0.28",
    "nanoid": "^5.1.11",
    "postal-mime": "^2.7.4",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^4.20260520.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.41",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "alchemy": "^2.0.0-beta.76",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "^9",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4",
    "turbo": "^2.10.12",
    "typescript": "^5.7.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.98.0"
  }
}
